include(${PROJECT_SOURCE_DIR}/cmake/CPM.cmake)
CPMAddPackage("gh:catchorg/Catch2@3.16.1")
list(APPEND CMAKE_MODULE_PATH ${Catch2_SOURCE_DIR}/extras)
include(Catch)

# Every *.test.cpp in this directory is compiled into the test runner.
file(GLOB test_sources CONFIGURE_DEPENDS *.test.cpp)
add_executable({{ package_name }}_tests ${test_sources})
target_link_libraries({{ package_name }}_tests PRIVATE {{ package_name }}::{{ package_name }} {{ package_name }}_warnings
                                               Catch2::Catch2WithMain)
catch_discover_tests({{ package_name }}_tests)
