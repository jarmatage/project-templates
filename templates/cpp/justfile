# Developer commands. `just check` is the gate: work is done when it passes.

sources := `find src tests examples -name '*.cpp' | sort | tr '\n' ' '`
files := sources + `find include src tests examples -name '*.hpp' | sort | tr '\n' ' '`

default:
    @just --list

# Configure the dev build (downloads dependencies, writes compile_commands.json) and install the git hooks
setup:
    cmake --preset dev
    -git rev-parse --git-dir > /dev/null 2>&1 && prek install

# Report missing tools
doctor:
    @command -v c++ > /dev/null || command -v g++ > /dev/null || command -v clang++ > /dev/null || echo "MISSING a C++ compiler (g++ or clang++)"
    @command -v cmake > /dev/null || echo "MISSING cmake: uv tool install cmake, or your distribution's package"
    @command -v ninja > /dev/null || echo "MISSING ninja: uv tool install ninja, or your distribution's package"
    @command -v clang-format > /dev/null || echo "MISSING clang-format: uv tool install clang-format, or your distribution's package"
    @command -v clang-tidy > /dev/null || echo "MISSING clang-tidy: uv tool install clang-tidy, or your distribution's package"
    @command -v gcovr > /dev/null || echo "MISSING gcovr (coverage): uv tool install gcovr"
    @command -v doxygen > /dev/null || echo "MISSING doxygen (docs): install your distribution's doxygen package"
    @command -v clangd > /dev/null || echo "MISSING clangd (language server): install your distribution's clangd package"
    @command -v prek > /dev/null || echo "MISSING prek (git hooks): uv tool install prek"
    @command -v ccache > /dev/null || echo "OPTIONAL ccache not found: rebuilds will be slower"
    @test -f build/dev/compile_commands.json || echo "No dev build yet (clangd and clang-tidy need it): run 'just setup'"

# Format
fmt:
    clang-format -i {{ files }}

# Fail if anything is unformatted
fmt-check:
    clang-format --dry-run --Werror {{ files }}

# Lint with clang-tidy; warnings are errors
lint:
    cmake --preset dev > /dev/null
    clang-tidy -p build/dev --quiet {{ sources }}

# Configure, build and run the tests; warnings are errors
test:
    cmake --workflow --preset dev

# Run the tests under AddressSanitizer and UndefinedBehaviorSanitizer
test-san:
    cmake --workflow --preset san

# Run the tests with a coverage report
cov:
    cmake --workflow --preset coverage
    gcovr --root . --filter include --filter src build/coverage

# Build the API documentation into build/docs
docs:
    doxygen docs/Doxyfile

# Build in release mode into build/release
build:
    cmake --preset release
    cmake --build --preset release

# The gate: everything that must pass before work is done
check: fmt-check lint test
