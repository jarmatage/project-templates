# Doxygen configuration; run with `just docs` from the repository root.
PROJECT_NAME           = "{{ project_name }}"
PROJECT_BRIEF          = "{{ description }}"
INPUT                  = README.md include
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = README.md
OUTPUT_DIRECTORY       = build/docs
GENERATE_LATEX         = NO
# Diagrams would need Graphviz, which is not part of the toolchain.
HAVE_DOT               = NO
EXTRACT_ALL            = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
QUIET                  = YES
