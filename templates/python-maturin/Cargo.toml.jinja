[workspace]
resolver = "3"
members = ["crates/*"]

[workspace.package]
version = "0.1.0"
edition = "2024"
description = "{{ description }}"
license = "{{ license }}"
authors = ["{{ author_name }} <{{ author_email }}>"]

[workspace.dependencies]
{{ project_name }}-core = { path = "crates/core" }
# abi3: one wheel works on every Python from {{ python_version }} up.
pyo3 = { version = "0.30", features = ["abi3-py{{ python_version | replace('.', '') }}"] }

[workspace.lints.rust]
missing_docs = "warn"

[workspace.lints.clippy]
pedantic = { level = "warn", priority = -1 }
