import pytest

from {{ package_name }} import fibonacci


@pytest.mark.parametrize(
    ("n", "expected"),
    [(0, 0), (1, 1), (2, 1), (10, 55), (93, 12200160415121876738)],
)
def test_fibonacci(n: int, expected: int) -> None:
    assert fibonacci(n) == expected


def test_fibonacci_reports_overflow() -> None:
    with pytest.raises(OverflowError):
        fibonacci(94)


def test_fibonacci_rejects_negative_input() -> None:
    with pytest.raises(TypeError):
        fibonacci(-1)
