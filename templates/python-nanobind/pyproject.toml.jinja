[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "{{ description }}"
readme = "README.md"
license = "{{ license }}"
license-files = ["LICENSE"]
authors = [{ name = "{{ author_name }}", email = "{{ author_email }}" }]
requires-python = ">={{ python_version }}"
dependencies = []

[dependency-groups]
# Python tools only: the compiler, cmake, ninja, clang-format and clang-tidy come
# from the system (`just doctor` reports what is missing).
dev = [
    "gcovr>=8",
    "nanobind>=2.9",
    "prek>=0.5",
    "pytest>=9",
    "pytest-cov>=7",
    "ruff>=0.17",
    "ty>=0.0.100",
]
docs = [
    "mkdocs-material>=9.6",
    "mkdocstrings[python]>=1",
]

[build-system]
requires = ["scikit-build-core>=0.12", "nanobind>=2.9"]
build-backend = "scikit_build_core.build"

[tool.scikit-build]
minimum-version = "build-system.requires"
build-dir = "build/{wheel_tag}"
wheel.packages = ["src/{{ package_name }}"]

[tool.uv]
# `uv sync` / `uv run` rebuild the extension when any of these change.
cache-keys = [
    { file = "pyproject.toml" },
    { file = "CMakeLists.txt" },
    { file = "cpp/**/*.{hpp,cpp}" },
]

[tool.ruff]
extend-exclude = ["src/*/_core.pyi"] # generated by `just stubs`

[tool.ruff.lint]
# Everything is on; switch a rule off here, with a reason, rather than inline.
select = ["ALL"]
ignore = [
    "COM812", # conflicts with the formatter
    "CPY",    # no per-file copyright headers
]

[tool.ruff.lint.pydocstyle]
convention = "google"

[tool.ruff.lint.per-file-ignores]
"tests/**" = [
    "D",       # tests do not need docstrings
    "INP001",  # tests/ is not a package
    "PLR2004", # literal values are fine in assertions
    "S101",    # assert is how pytest works
]

[tool.ty.rules]
# Strict rules that ty leaves off by default.
blanket-ignore-comment = "error"            # a suppression names its rule
disjoint-cast = "error"                     # no cast between unrelated types
dynamic-function-decorator-return = "error" # decorators keep the function's type
missing-type-argument = "error"             # no bare `list` or `dict`
unsound-assignment = "error"                # `Any` does not pass for a declared type
unsound-return-statement = "error"
unsound-yield = "error"

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = ["-ra", "--strict-markers", "--strict-config"]
xfail_strict = true
filterwarnings = ["error"]

[tool.coverage.run]
source_pkgs = ["{{ package_name }}"]
branch = true

[tool.coverage.report]
show_missing = true
exclude_also = ["if TYPE_CHECKING:", "if __name__ == .__main__.:"]
