#include <nanobind/nanobind.h>

#include "{{ package_name }}/fibonacci.hpp"

namespace nb = nanobind;
using nb::literals::operator""_a;

// NOLINTNEXTLINE(*) - the module entry point is generated by a nanobind macro
NB_MODULE(_core, m) {
  m.doc() = "Native implementation module; re-exported by the `{{ package_name }}` Python package.";

  m.def("fibonacci", &{{ package_name }}::fibonacci, "n"_a,
        R"doc(Return the n-th Fibonacci number.

Args:
    n: Zero-based position in the sequence, so ``fibonacci(0) == 0``.

Returns:
    The n-th Fibonacci number.

Raises:
    TypeError: If ``n`` is negative.
    OverflowError: If the result does not fit in 64 bits.)doc");
}
