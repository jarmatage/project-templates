site_name: {{ project_name }}
site_description: {{ description | to_json }}
theme:
  name: material
plugins:
  - search
  - mkdocstrings:
      handlers:
        python:
          paths: [src]
# `just docs-serve` also reloads when docstrings change.
watch:
  - src
nav:
  - Home: index.md
  - API reference: api.md
